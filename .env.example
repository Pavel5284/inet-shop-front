# Скопируйте в .env.local, если нужно переопределить значения для `npm run dev`.
# (Значения VITE_* попадают в код при сборке.)

# Адрес GraphQL. По умолчанию относительный /graphql: в dev его проксирует Vite, в Docker — nginx.
# VITE_GRAPHQL_URL=/graphql

# Куда Vite (dev-сервер) проксирует /graphql
# VITE_DEV_PROXY_TARGET=http://localhost:3000

# Валюта (ISO 4217): RUB, KZT, USD, EUR ...
# VITE_CURRENCY=RUB

# Кнопка «Войти как демо-пользователь» на странице входа (на боевом сервере поставьте false)
# VITE_SHOW_DEMO_LOGIN=true
